{
  "name": "aerial-twin",
  "private": true,
  "version": "0.1.0",
  "description": "3D digital twin (Build Plan M7): CARLA lane map, live/replay vehicles, violations, planner edits. CesiumJS + Vite, port 5174.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest run"
  },
  "dependencies": {
    "cesium": "1.145.0"
  },
  "overrides": {
    "@cesium/engine": "26.3.0",
    "@cesium/widgets": "16.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.2"
  }
}
